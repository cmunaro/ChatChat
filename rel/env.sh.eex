#!/bin/sh

if [ "$RELEASE_NAME" = "chatchat_tcp" ] && [ -n "${TCP_CLUSTER_DNS:-}" ]; then
  # Compose gives each replica one address on the private service network.
  # DNSPoll connects to chatchat_tcp@<address>, so the release must use that name.
  export RELEASE_DISTRIBUTION=name
  export RELEASE_NODE="chatchat_tcp@$(hostname -i | awk '{print $1}')"
  : "${RELEASE_COOKIE:?RELEASE_COOKIE is required for clustered TCP nodes}"
fi
