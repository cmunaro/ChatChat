  "panels": [
    {
      "id": 29,
      "title": "Metric availability",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Runtime gauges require the freshness collector. **Collector not deployed** means the running TCP image predates it; rebuild application images for the next run. Legacy readings below have **unverified collection freshness** and can freeze under load. Never sum their connection counts: older nodes each report the cluster total. HAProxy sessions are live backend sockets, including sockets not yet authenticated. Event charts can be empty until matching events occur; HTTP charts exclude unrecognized routes (including metrics scrapes). Task 2 diagnostics require updated TCP images."
      }
    },
    {
      "id": 30,
      "title": "TCP sessions (HAProxy)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              }
            ]
          },
          "noValue": "Unknown / stale"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(haproxy_server_current_sessions{proxy=\"chatchat_tcp_nodes\"} and on (job, instance) (up{job=\"haproxy\"} == 1))",
          "instant": true
        }
      ],
      "description": "Live backend socket count from HAProxy, not authenticated-client count. Requires exporter up."
    },
    {
      "id": 31,
      "title": "Legacy runtime readings \u2014 freshness unverified",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 4,
        "w": 18,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "noValue": "No legacy exporters"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(chatchat_tcp_connected_clients{job=\"chatchat_tcp\"} and on (job, instance) (up{job=\"chatchat_tcp\"} == 1)) unless on (job, instance) chatchat_runtime_collection_success",
          "legendFormat": "Cluster clients {{instance}}"
        },
        {
          "refId": "B",
          "expr": "(chatchat_delivery_active_workers{job=\"chatchat_tcp\"} and on (job, instance) (up{job=\"chatchat_tcp\"} == 1)) unless on (job, instance) chatchat_runtime_collection_success",
          "legendFormat": "Inbox workers {{instance}}"
        },
        {
          "refId": "C",
          "expr": "(chatchat_delivery_pending_receivers{job=\"chatchat_tcp\"} and on (job, instance) (up{job=\"chatchat_tcp\"} == 1)) unless on (job, instance) chatchat_runtime_collection_success",
          "legendFormat": "Pending receivers {{instance}}"
        },
        {
          "refId": "D",
          "expr": "(chatchat_delivery_attempts{job=\"chatchat_tcp\"} and on (job, instance) (up{job=\"chatchat_tcp\"} == 1)) unless on (job, instance) chatchat_runtime_collection_success",
          "legendFormat": "Sender attempts {{instance}}"
        },
        {
          "refId": "E",
          "expr": "(chatchat_postgres_undelivered_messages{job=\"chatchat_tcp\"} and on (job, instance) (up{job=\"chatchat_tcp\"} == 1)) unless on (job, instance) chatchat_runtime_collection_success",
          "legendFormat": "Database pending {{instance}}"
        }
      ],
      "description": "Compatibility view only for exporters without collection health. Values may be frozen even while scraping succeeds. Kept per exporter to avoid double-counting cluster-wide legacy gauges."
    },
    {
      "id": 1,
      "title": "Service health",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red"
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "min by (job) (up{job=~\"chatchat_web|chatchat_tcp|haproxy\"})",
          "instant": true,
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Connected TCP clients",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              }
            ]
          },
          "noValue": "Unknown / stale"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum((chatchat_tcp_connected_clients and on (job, instance) (chatchat_runtime_collection_success{source=\"connections\"} == 1 and on (job, instance, source) (time() - chatchat_runtime_collection_last_success_timestamp_seconds{source=\"connections\"} < 15) and on (job, instance) (up{job=\"chatchat_tcp\"} == 1)))) and on () (count((chatchat_runtime_collection_success{source=\"connections\"} == 1 and on (job, instance, source) (time() - chatchat_runtime_collection_last_success_timestamp_seconds{source=\"connections\"} < 15) and on (job, instance) (up{job=\"chatchat_tcp\"} == 1))) == count(up{job=\"chatchat_tcp\"}))",
          "instant": true,
          "legendFormat": "Connected",
          "refId": "A"
        }
      ],
      "description": "Runtime values require successful collection within 15 seconds and a healthy scrape. Node totals require every discovered TCP exporter. PostgreSQL is a shared database and uses the maximum fresh observation."
    },
    {
