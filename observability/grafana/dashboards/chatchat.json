{
  "annotations": {
    "list": []
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "Service health",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red"
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "min by (job) (up{job=~\"chatchat_web|chatchat_tcp|haproxy\"})",
          "instant": true,
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Connected TCP clients",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              }
            ]
          },
          "noValue": "Unknown / stale"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum((chatchat_tcp_connected_clients and on (job, instance) (chatchat_runtime_collection_success{source=\"connections\"} == 1 and on (job, instance, source) (time() - chatchat_runtime_collection_last_success_timestamp_seconds{source=\"connections\"} < 15) and on (job, instance) (up{job=\"chatchat_tcp\"} == 1)))) and on () (count((chatchat_runtime_collection_success{source=\"connections\"} == 1 and on (job, instance, source) (time() - chatchat_runtime_collection_last_success_timestamp_seconds{source=\"connections\"} < 15) and on (job, instance) (up{job=\"chatchat_tcp\"} == 1))) == count(up{job=\"chatchat_tcp\"}))",
          "instant": true,
          "legendFormat": "Connected",
          "refId": "A"
        }
      ],
      "description": "Runtime values require successful collection within 15 seconds and a healthy scrape. Node totals require every discovered TCP exporter. PostgreSQL is a shared database and uses the maximum fresh observation."
    },
    {
      "id": 3,
      "title": "Pending ownership",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "orange",
                "value": 100
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          },
          "noValue": "Unknown / stale"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "max((chatchat_postgres_undelivered_messages and on (job, instance) (chatchat_runtime_collection_success{source=\"postgres\"} == 1 and on (job, instance, source) (time() - chatchat_runtime_collection_last_success_timestamp_seconds{source=\"postgres\"} < 15) and on (job, instance) (up{job=\"chatchat_tcp\"} == 1))))",
          "legendFormat": "PostgreSQL",
          "refId": "A",
          "instant": true
        },
        {
          "expr": "sum((chatchat_delivery_attempts and on (job, instance) (chatchat_runtime_collection_success{source=\"sender\"} == 1 and on (job, instance, source) (time() - chatchat_runtime_collection_last_success_timestamp_seconds{source=\"sender\"} < 15) and on (job, instance) (up{job=\"chatchat_tcp\"} == 1)))) and on () (count((chatchat_runtime_collection_success{source=\"sender\"} == 1 and on (job, instance, source) (time() - chatchat_runtime_collection_last_success_timestamp_seconds{source=\"sender\"} < 15) and on (job, instance) (up{job=\"chatchat_tcp\"} == 1))) == count(up{job=\"chatchat_tcp\"}))",
          "legendFormat": "Active attempts",
          "refId": "B",
          "instant": true
        }
      ],
      "description": "Runtime values require successful collection within 15 seconds and a healthy scrape. Node totals require every discovered TCP exporter. PostgreSQL is a shared database and uses the maximum fresh observation."
    },
