      "targets": [
        {
          "expr": "sum((chatchat_delivery_active_workers and on (job, instance) (chatchat_runtime_collection_success{source=\"inbox\"} == 1 and on (job, instance, source) (time() - chatchat_runtime_collection_last_success_timestamp_seconds{source=\"inbox\"} < 15) and on (job, instance) (up{job=\"chatchat_tcp\"} == 1)))) and on () (count((chatchat_runtime_collection_success{source=\"inbox\"} == 1 and on (job, instance, source) (time() - chatchat_runtime_collection_last_success_timestamp_seconds{source=\"inbox\"} < 15) and on (job, instance) (up{job=\"chatchat_tcp\"} == 1))) == count(up{job=\"chatchat_tcp\"}))",
          "instant": true,
          "legendFormat": "Active",
          "refId": "A"
        },
        {
          "expr": "sum((chatchat_delivery_pending_receivers and on (job, instance) (chatchat_runtime_collection_success{source=\"inbox\"} == 1 and on (job, instance, source) (time() - chatchat_runtime_collection_last_success_timestamp_seconds{source=\"inbox\"} < 15) and on (job, instance) (up{job=\"chatchat_tcp\"} == 1)))) and on () (count((chatchat_runtime_collection_success{source=\"inbox\"} == 1 and on (job, instance, source) (time() - chatchat_runtime_collection_last_success_timestamp_seconds{source=\"inbox\"} < 15) and on (job, instance) (up{job=\"chatchat_tcp\"} == 1))) == count(up{job=\"chatchat_tcp\"}))",
          "instant": true,
          "legendFormat": "Pending",
          "refId": "B"
        }
      ],
      "description": "Runtime values require successful collection within 15 seconds and a healthy scrape. Node totals require every discovered TCP exporter. PostgreSQL is a shared database and uses the maximum fresh observation."
