        "w": 24,
        "x": 0,
        "y": 55
      },
      "description": "Fresh means collection succeeded within 15 seconds and exporter is up. Failed, expired, or missing collections are shown per discovered node/source. No discovered exporters means Unknown / stale.",
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown / stale",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Failed / stale",
                  "color": "red"
                },
                "1": {
                  "text": "Fresh",
                  "color": "green"
                }
              }
            }
          ],
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "((chatchat_runtime_collection_success == bool 1) * on (job, instance, source) (time() - chatchat_runtime_collection_last_success_timestamp_seconds < bool 15) * on (job, instance) group_left() up{job=\"chatchat_tcp\"}) or on (job, instance, source) (label_replace(0 * up{job=\"chatchat_tcp\"}, \"source\", \"connections\", \"job\", \".*\") or label_replace(0 * up{job=\"chatchat_tcp\"}, \"source\", \"inbox\", \"job\", \".*\") or label_replace(0 * up{job=\"chatchat_tcp\"}, \"source\", \"sender\", \"job\", \".*\") or label_replace(0 * up{job=\"chatchat_tcp\"}, \"source\", \"postgres\", \"job\", \".*\"))",
          "instant": true,
          "legendFormat": "{{instance}} {{source}}",
          "refId": "A"
        }
      ]
    }
